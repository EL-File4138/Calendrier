{
  "name": "calendrier-worker",
  "version": "1.0.1-rc.2",
  "description": "Cloudflare Worker for Calendrier multi-user sync",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build",
    "tail": "wrangler tail"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "durable-objects",
    "calendar"
  ],
  "author": "",
  "license": "Unlicense",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.95.0"
  }
}
