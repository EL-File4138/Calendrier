{
  "name": "calendrier-worker",
  "version": "1.0.1-rc.2",
  "description": "Cloudflare Worker for Calendrier multi-user sync",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "yarn typecheck && yarn build",
    "tail": "wrangler tail"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "durable-objects",
    "calendar"
  ],
  "author": "",
  "license": "Unlicense",
  "resolutions": {
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.143.0"
  },
  "packageManager": "yarn@1.22.22"
}
