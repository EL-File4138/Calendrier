# Calendrier Worker Environment Variables (Development Only)
# Copy this file to .dev.vars and fill in your values
# IMPORTANT: Never commit .dev.vars to version control

# Admin Master Token - Used for creating/revoking activation tokens
# Generate a secure random token with: openssl rand -hex 32
# Must be at least 32 characters long
ADMIN_MASTER_TOKEN=your-64-character-hex-token-here
